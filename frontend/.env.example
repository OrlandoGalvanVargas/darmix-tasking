# URL base de la API.
# En dev: "/api" usa el proxy de Vite hacia http://127.0.0.1:8000
# En prod con backend: "https://tu-backend.com/api"
# En prod sin backend: se cae a modo local automáticamente
VITE_API_URL=/api

# auto   → ping al backend; si falla, usa modo local
# remote → siempre HTTP (útil para forzar error si el backend no responde)
# local  → siempre datos locales (útil para demo sin backend)
VITE_API_MODE=auto